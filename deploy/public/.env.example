# Hagency public server settings. Copy to .env (chmod 600) and fill in.
# Secrets go in this file or in ./secrets/<name> files (both gitignored), never in git.

# --- Names (permanent: changing SERVER_NAME later orphans every account and room) ---
DOMAIN=matrix.hagencylabs.xyz         # hagency-server + Palpo: /_matrix, /auth, /hagency
ELEMENT_DOMAIN=app.hagencylabs.xyz    # Element Web (separate origin on purpose)
SERVER_NAME=hagencylabs.xyz           # Matrix server name: user IDs @name:hagencylabs.xyz
ROOT_MODE=caddy                       # caddy: Caddy serves https://SERVER_NAME/.well-known + redirect to app
                                      # external: landing page elsewhere (Cloudflare Pages/Vercel) serves .well-known
ACME_EMAIL=ops@hagencylabs.xyz        # Let's Encrypt account e-mail
TLS_MODE=acme                         # acme (public) | internal (local test, self-signed CA)
                                      # tunnel (Cloudflare Tunnel terminates HTTPS; Caddy plain HTTP on
                                      # BIND_ADDR=127.0.0.1:HTTP_PORT, HTTPS_PORT unused; see README)
EDGE_SUBNET=172.30.18.0/24            # tunnel only: pinned edge network; its .1 may set CF-Connecting-IP

# --- Host ports (the public box uses 80/443; local tests use high ports on 127.0.0.1) ---
BIND_ADDR=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
COMPOSE_PROJECT_NAME=hagency-public

# --- Images: build locally (default) or pull prebuilt ones from a registry ---
IMAGE_MODE=build                      # build | pull | local (use images already on this host)
SERVER_IMAGE=hagency-public/server:local
CONCIERGE_IMAGE=hagency-public/concierge:local
CADDY_IMAGE=hagency-public/caddy:local     # Caddy + rate-limit module (Dockerfile target caddy)
BUILD_JOBS=2                          # cargo jobs; keep low on 1-4 GB machines

# --- Admin (created once by deploy.sh; password generated into secrets/admin_password) ---
ADMIN_USER=admin

# --- Registration: invite (default) | approval | open | closed ---
#   invite : sign-up needs a one-time token from `./deploy.sh invite`
#   approval: NOT implemented in this server build yet; deploy.sh refuses it
#   open   : anyone can sign up (only with caps and monitoring in place)
#   closed : no new accounts
REGISTRATION_MODE=invite

# --- Federation: comma-separated allowlist of server names; empty = federate with nobody ---
FEDERATION_ALLOWLIST=

# --- GitHub sign-in (OAuth App; callback https://DOMAIN/auth/upstream/callback/01M7BKN7F5NRSNBNR7P3CEDYGR) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=                 # or put it in secrets/github_client_secret

# --- Google sign-in: placeholders only, not wired in this bundle yet ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server-hosted agents (concierge) ---
CONCIERGE_ENABLED=true
CONCIERGE_USER=hagency
CONCIERGE_DAILY_TOKENS=200000         # per hosted Agent per UTC day (its Policy budget)
CONCIERGE_MAX_AGENTS_PER_USER=1
# Hosted agents use Ollama (no commercial API key): Codex's OSS provider points here.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AGENTS_ENABLED=true                   # kill switch; `./deploy.sh kill-agents` sets false

# --- Calls (optional profile "calls"; LiveKit Cloud, no TURN run here) ---
CALLS_ENABLED=false
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_KEY=
LIVEKIT_SECRET=
ELEMENT_CALL_URL=https://call.element.io

# --- Caps (safe defaults for a public lab) ---
MAX_UPLOAD_SIZE=20MB                  # Caddy request body limit
MAX_UPLOAD_BYTES=20971520             # Palpo max_upload_size (same value in bytes)
RL_AUTH_PER_MIN=10                    # per IP: /auth sign-in/sign-up + Matrix login/register
RL_CREATEROOM_PER_HOUR=20             # per IP
RL_SEND_PER_MIN=60                    # per IP: message sends
RL_UPLOAD_PER_HOUR=60                 # per IP: media uploads
RL_GENERAL_PER_MIN=600                # per IP: everything on DOMAIN
# Pasion sees all traffic from Caddy (server forces trusted_proxies = []), so its per-IP
# limits are global ceilings; real per-IP caps are RL_AUTH_PER_MIN above.
PASION_LOGIN_BURST=120
PASION_LOGIN_PER_SECOND=2
PASION_REGISTRATION_BURST=30
PASION_REGISTRATION_PER_SECOND=0.2
PALPO_RC_MESSAGE_PER_SECOND=0.5       # per user message rate in Palpo
PALPO_RC_MESSAGE_BURST=10
PALPO_MAX_CONCURRENT_REQUESTS=200
PALPO_DB_POOL_SIZE=10
PG_MAX_CONNECTIONS=60
PG_STATEMENT_TIMEOUT=60s
# Container CPU/memory caps (Oracle A1 4 OCPU / 24 GB has room; lower on small VPS)
PG_CPUS=1.0
PG_MEM=1g
SERVER_CPUS=2.0
SERVER_MEM=2g
CONCIERGE_CPUS=2.0
CONCIERGE_MEM=2g
# --- Alerts: ./alerts.sh (cron every 5 min) posts log matches to this webhook ---
ALERT_WEBHOOK_URL=                    # e.g. a Slack/Discord/ntfy incoming webhook; empty = print only
ALERT_PATTERN='panic|FATAL|ERROR|out of memory|OOM|budget exhausted| 429 '
ALERT_DISK_PCT=85                     # alert when the Docker disk is this full
# --- Backups ---
CADDY_TRUSTED_PROXIES=                # e.g. Cloudflare ranges when the orange cloud is on; tunnel default: EDGE_SUBNET .1/32
BACKUP_DIR=./backups
BACKUP_KEEP=14
