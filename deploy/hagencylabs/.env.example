# hagencylabs.xyz environment settings (NO secrets in this file; secrets live in
# secrets/<env>.env, written by ./gen-secrets.sh <env>).
# Copy to env/production.env or env/staging.env on the host, chmod 600. The file
# is sourced by bash: quote values containing spaces or < >.
# Values below are PRODUCTION; the staging line follows each one that differs.

DEPLOY_ENV=production                 # staging: DEPLOY_ENV=staging
COMPOSE_PROJECT_NAME=hagencylabs-production   # staging: hagencylabs-staging

# --- Names (Matrix server_name is permanent; staging must never reuse production's)
SERVER_NAME=hagencylabs.xyz           # staging: staging.hagencylabs.xyz
DOMAIN=matrix.hagencylabs.xyz         # staging: matrix.staging.hagencylabs.xyz
ELEMENT_DOMAIN=app.hagencylabs.xyz    # staging: app.staging.hagencylabs.xyz
# Public IPv4 of the host DOMAIN must resolve to (deploy.sh warns on mismatch).
HOST_PUBLIC_IP=3.208.213.20           # staging (beta): 44.216.75.205
BRAND=Hagency                         # staging: Hagency Staging

# --- TLS (Caddy, Let's Encrypt HTTP-01 on port 80)
ACME_EMAIL=ops@hagencylabs.xyz        # must receive mail (ImprovMX forward); expiry notices go here
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# First experiments may use https://acme-staging-v02.api.letsencrypt.org/directory
# (untrusted certs: federation and browsers will refuse them; switch back before checks).

# --- Images. build-image.sh tags <repo>:<git-commit-12>; deploy.sh --tag picks one.
SERVER_IMAGE_REPO=hagencylabs/server  # or ghcr.io/csheargm/hagency-server once a registry is chosen
CADDY_IMAGE_REPO=hagencylabs/caddy
# pull = docker pull from the registry; local = image must already be on this host
# (docker load of an archive from build-image.sh --save, or built here).
IMAGE_SOURCE=local

# --- Accounts
ADMIN_USER=hagency-admin              # lowercase Matrix localpart; password in secrets/<env>.env
# invite = password sign-up needs a one-time token (./deploy.sh <env> invite);
# open = anyone; closed = no password sign-up. GitHub sign-in works in every mode.
REGISTRATION_MODE=invite              # staging: open
# Fixed ULID the Hagency desktop reads from /native/config (same as the Mac demo).
NATIVE_DESKTOP_CLIENT_ID=01JD3SKT0PNAT1VE0000000000
# GitHub OAuth app (one per environment; callback URL printed by gen-secrets.sh).
# Empty = GitHub sign-in off. The client secret goes in secrets/<env>.env.
GITHUB_CLIENT_ID=
# Email (Resend). Empty RESEND_API_KEY in secrets/<env>.env = no email, no recovery.
EMAIL_FROM='"Hagency" <no-reply@hagencylabs.xyz>'
EMAIL_REPLY_TO='"Hagency" <support@hagencylabs.xyz>'

# --- Agents and federation
AGENTS_ENABLED=true                   # false = kill switch for server-side agent execution
# allowlist (approved peering design) or open. Comma list of server names.
FEDERATION_MODE=allowlist
FEDERATION_ALLOWLIST=staging.hagencylabs.xyz   # staging: hagencylabs.xyz

# --- Calls (optional, LiveKit Cloud). LIVEKIT_SECRET goes in secrets/<env>.env.
CALLS_ENABLED=false
LIVEKIT_URL=
LIVEKIT_KEY=

# --- Limits (per client IP in Caddy; per user in Palpo)
MAX_UPLOAD_SIZE=20MB
MAX_UPLOAD_BYTES=20000000
RL_AUTH_PER_MIN=10
RL_CREATEROOM_PER_HOUR=20
RL_UPLOAD_PER_HOUR=60
RL_GENERAL_PER_MIN=600
RL_FEDERATION_PER_MIN=3000
PALPO_RC_MESSAGE_PER_SECOND=2
PALPO_RC_MESSAGE_BURST=30
PALPO_MAX_CONCURRENT_REQUESTS=200
PALPO_DB_POOL_SIZE=10
PG_MAX_CONNECTIONS=60

# --- Container caps (alpha: 4 CPU / 15 GB; beta: 2 CPU / 7.6 GB)
SERVER_CPUS=3.0                       # staging: 1.5
SERVER_MEM=6g                         # staging: 3g
PG_CPUS=1.0
PG_MEM=2g                             # staging: 1g

# --- Backups and rollback
BACKUP_DIR=/var/backups/hagencylabs   # per-env subdirectory is added; mode 0700
BACKUP_KEEP=14
# age public key (age1...): also write an encrypted copy for off-host storage.
BACKUP_AGE_RECIPIENT=
# After a failed deploy the previous image is restored automatically. Database:
# ask (prompt on a terminal, keep otherwise) | restore (pre-deploy dump) | keep.
ROLLBACK_DB=ask
