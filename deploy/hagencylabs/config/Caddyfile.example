# Rendered by deploy.sh into runtime/<env>/Caddyfile. Edit this template, not the output.
# Sites: ${SERVER_NAME} (Matrix server name: .well-known delegation, else -> app),
#        ${DOMAIN} (hagency-server: /_matrix client+federation, /auth, /hagency, web app),
#        ${ELEMENT_DOMAIN} (Element Web). Federation is delegated to ${DOMAIN}:443; no 8448.
{
	email ${ACME_EMAIL}
	acme_ca ${ACME_CA}
	order rate_limit before basic_auth
}

# Per-client-IP caps (mholt/caddy-ratelimit); 429 when exceeded. Values from env RL_*.
(rate_limits) {
	rate_limit {
		zone auth {
			match {
				path /auth/api/v1/auth/* /auth/login* /auth/register*
			}
			key {client_ip}
			events ${RL_AUTH_PER_MIN}
			window 1m
		}
		zone matrix_auth {
			match {
				path_regexp ^/_matrix/client/[^/]+/(login|register)
			}
			key {client_ip}
			events ${RL_AUTH_PER_MIN}
			window 1m
		}
		zone create_room {
			match {
				path_regexp ^/_matrix/client/[^/]+/createRoom
			}
			key {client_ip}
			events ${RL_CREATEROOM_PER_HOUR}
			window 1h
		}
		zone media_upload {
			match {
				path_regexp ^/_matrix/(media|client)/[^/]+/(upload|media/upload)
			}
			key {client_ip}
			events ${RL_UPLOAD_PER_HOUR}
			window 1h
		}
		# Federation gets its own, larger bucket: one busy peer (or many users
		# behind one NAT) must not starve the other side, and vice versa.
		zone federation {
			match {
				path /_matrix/federation/* /_matrix/key/*
			}
			key {client_ip}
			events ${RL_FEDERATION_PER_MIN}
			window 1m
		}
		zone all {
			match {
				not path /_matrix/federation/* /_matrix/key/*
			}
			key {client_ip}
			events ${RL_GENERAL_PER_MIN}
			window 1m
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(matrix_well_known) {
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server":"${DOMAIN}:443"}` 200
	}
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `${WELL_KNOWN_CLIENT_JSON}` 200
	}
}

${SERVER_NAME} {
	import security_headers
	import matrix_well_known
	handle {
		redir ${ELEMENT_URL}{uri} 302
	}
}

${DOMAIN} {
	import security_headers
	import rate_limits
	request_body {
		max_size ${MAX_UPLOAD_SIZE}
	}
	import matrix_well_known
	${CALLS_ROUTE}
	# No Synapse-style admin or metrics paths in public.
	handle /_synapse/* {
		respond 404
	}
	handle {
		reverse_proxy server:8088
	}
}

${ELEMENT_DOMAIN} {
	import security_headers
	header X-Frame-Options SAMEORIGIN
	reverse_proxy element:80
}
