# GitHub sign-in (included in pasion.toml when GITHUB_CLIENT_ID is set).
# Same claims mapping as the Mac demo (hagency-fed-up.sh): localpart is the
# lowercased GitHub login; a taken name fails instead of linking onto it.
# OAuth app callback URL: ${PUBLIC_URL}/auth/upstream/callback/${GITHUB_PROVIDER_ID}
[[upstream_oauth2.providers]]
id = "${GITHUB_PROVIDER_ID}"
brand_name = "github"
human_name = "GitHub"
client_id = "${GITHUB_CLIENT_ID}"
client_secret_file = "/run/hagency/config/github-client.secret"
token_endpoint_auth_method = "client_secret_post"
discovery_mode = "disabled"
pkce_method = "never"
fetch_userinfo = true
authorization_endpoint = "https://github.com/login/oauth/authorize"
token_endpoint = "https://github.com/login/oauth/access_token"
userinfo_endpoint = "https://api.github.com/user"
scope = "read:user user:email"
claims_imports.subject.template = "{{ userinfo_claims.id }}"
claims_imports.skip_confirmation = true
claims_imports.localpart = { action = "require", template = "{{ userinfo_claims.login | lower }}", on_conflict = "fail" }
claims_imports.displayname = { action = "force", template = "{{ userinfo_claims.name or userinfo_claims.login }}" }
claims_imports.email = { action = "ignore" }
